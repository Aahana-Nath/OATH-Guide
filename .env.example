# Copy to .env and fill in. Never commit .env.

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model to use. Leave blank to auto-detect a Flash model. Smaller "flash-lite" models are the most reliable under load.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: models to fall back to when the main one is overloaded or unavailable (comma-separated)
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest

# Optional: Firecrawl (https://firecrawl.dev). Gives the agent a better web search and reads JavaScript-rendered docs pages.
# Used only where robots.txt allows; if the key is missing, out of credits or invalid, the built-in reader and search take over.
# FIRECRAWL_API_KEY=fc-...
# FIRECRAWL_MAX_SCRAPES=25
